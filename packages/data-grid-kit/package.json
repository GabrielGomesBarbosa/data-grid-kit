{
  "name": "data-grid-kit",
  "version": "0.11.0",
  "description": "Headless-first React data grid: hooks + store core, unstyled-friendly UI",
  "license": "MIT",
  "author": "Gabriel Gomes Barbosa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielGomesBarbosa/data-grid-kit.git",
    "directory": "packages/data-grid-kit"
  },
  "homepage": "https://github.com/GabrielGomesBarbosa/data-grid-kit#readme",
  "bugs": {
    "url": "https://github.com/GabrielGomesBarbosa/data-grid-kit/issues"
  },
  "keywords": [
    "react",
    "data-grid",
    "datagrid",
    "table",
    "headless",
    "virtualization",
    "pivot",
    "tree-data",
    "row-grouping",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./locales": {
      "import": {
        "types": "./dist/locales.d.ts",
        "default": "./dist/locales.js"
      },
      "require": {
        "types": "./dist/locales.d.cts",
        "default": "./dist/locales.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./structure.css": "./dist/structure.css",
    "./theme.css": "./dist/theme.css",
    "./xlsx-worker": "./dist/xlsx-worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.worker.config.ts && node scripts/build-css.mjs && node scripts/finalize-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts && tsx scripts/xlsx-bench.ts",
    "lint:package": "publint && attw --pack . --exclude-entrypoints ./xlsx-worker ./styles.css ./structure.css ./theme.css",
    "verify:xlsx": "sh scripts/verify-xlsx.sh"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.31",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/index.js",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "locales": [
        "./dist/locales.d.ts"
      ]
    }
  }
}
