{
  "name": "data-grid-kit",
  "version": "0.1.0",
  "description": "Headless-first React data grid: hooks + store core, unstyled-friendly UI",
  "license": "MIT",
  "author": "Gabriel Gomes Barbosa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielGomesBarbosa/data-grid-kit.git",
    "directory": "packages/data-grid-kit"
  },
  "homepage": "https://github.com/GabrielGomesBarbosa/data-grid-kit#readme",
  "bugs": {
    "url": "https://github.com/GabrielGomesBarbosa/data-grid-kit/issues"
  },
  "keywords": [
    "react",
    "data-grid",
    "datagrid",
    "table",
    "headless",
    "virtualization",
    "pivot",
    "tree-data",
    "row-grouping",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/ui/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts && tsx scripts/xlsx-bench.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
