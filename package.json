{
  "name": "data-grid-kit-monorepo",
  "private": true,
  "description": "data-grid-kit: a headless-first, unstyled-by-default React data grid. This repository holds the library, the docs site and example apps.",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "turbo run bench --filter=data-grid-kit",
    "check": "turbo run typecheck test build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=data-grid-kit && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielGomesBarbosa/data-grid-kit.git"
  }
}
