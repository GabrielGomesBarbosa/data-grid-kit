{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["src/**", "vitest.config.ts", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "bench": {
      "cache": false
    }
  }
}
